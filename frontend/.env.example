# Copy to .env.local for development, or set in the host's dashboard for a deployment.
#
# Vite only exposes variables prefixed VITE_, and it inlines them at BUILD time — they are
# baked into the bundle, not read at runtime. Two consequences worth knowing:
#
#   * Changing this on the host requires a rebuild, not a restart.
#   * Anything in here is public. It is the API's address, which is public anyway; a secret
#     must never be put in a VITE_ variable, because it ships to every browser.

# The API's origin, with no trailing slash. Defaults to the dev API when unset, which
# backend/src/http/cors.js already allows.
VITE_API_URL=http://localhost:4000

# For the deployment, this becomes the Render API's URL, e.g.
# VITE_API_URL=https://restaurant-orders-api.onrender.com
#
# And the reverse has to be set too: CORS_ORIGINS on the API must name this site's origin, or
# the browser will refuse to hand it any response. Unset in production it resolves to nothing —
# the API fails closed rather than accepting every origin — so the deployed frontend cannot
# reach the deployed API until that variable exists.
