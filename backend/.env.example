
# Runtime: Supavisor transaction pooler, port 6543. What the API uses.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres

# Migrations and seed: Supavisor session pooler, port 5432. Needs a stable session for the
# migration advisory lock. Falls back to DATABASE_URL if unset.
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Set to true once the Supabase CA bundle is pinned; see the comment in src/db.js.
PGSSL_REJECT_UNAUTHORIZED=false
PGPOOL_MAX=5

# "Today" for the dashboard, date filters and CSV export (Decision 11). The API host runs in
# UTC; a 23:30 IST dinner must not count as tomorrow.
RESTAURANT_TZ=Asia/Kolkata

# Slow-order alerts (§10): open and not yet Ready for this long raises an alert; an
# acknowledged alert comes back this long afterwards if the order is still not Ready.
SLOW_ORDER_MINUTES=20
ALERT_REPEAT_MINUTES=10

# Sessions (Decision 8). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Origins the browser frontend is served from, comma-separated. Unset falls back to Vite's dev
# server in development and to nothing in production, so a deployment that forgets this fails
# closed rather than accepting every origin.
CORS_ORIGINS=http://localhost:5173

PORT=4000
NODE_ENV=development
